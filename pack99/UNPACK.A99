;
;****************************************************************
;
;	UNPACK - unpack a PACK99 archive on the TMS99105 SBC
;
;	USAGE:  UNPACK <ARCHIVE>       (no extension: .PAK)
;
;	One XMODEM transfer brings many files: pack99.ps1 on Windows
;	bundles them into one archive, XMODEM sends it, and UNPACK
;	writes each file back out under its own name, in the current
;	folder, replacing any file of that name.
;
;	ARCHIVE FORMAT - all sector aligned, so UNPACK only ever moves
;	whole 512-byte sectors:
;	   per file:  one header sector, then the file's data sectors
;	   at the end: one header sector whose name starts with 0
;	HEADER SECTOR (big-endian words):
;	    0-3   'PK99'
;	    4-14  name, FCB form: 8 + 3, space padded, upper case
;	   15     file type, as XMODEM: COM 1, EXE 2, TXT 3, BAS 4,
;	          PRO 5, anything else 0
;	   16-17  load address (>1000, as XMODEM's default)
;	   18-19  number of data sectors that follow
;	   20-23  the file's exact length in bytes (information only)
;	The last data sector of a file is padded with >1A, as an XMODEM
;	transfer from Tera Term pads it, so a file arrives exactly as
;	if XMODEM had brought it on its own.
;
;	BDOS: every call gets its FCB staged in the common FCB (COMM_FCB)
;	and the data always goes through the common buffer (COMM_BUF),
;	as IOLIB and XMODEM do.  The archive and the file being written
;	keep their own FCBs here.  The BDOS keeps no register, so the
;	loop state lives in memory.
;
;	Version 1.0  17 November 2026
;
;****************************************************************
;
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	PUSH,8
	DXOP	POP,9
;
R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
SP	EQU	10
;
;	SHELL AND BDOS
;
SHELL	EQU	80H		;RETURN TO THE SHELL
BDOS	EQU	84H		;BDOS ENTRY
CMDLINE	EQU	0A0H		;POINTER TO THE COMMAND LINE
COMMBUF	EQU	0A4H		;POINTER TO THE COMMON 512-BYTE BUFFER
COMMFCB	EQU	0ACH		;POINTER TO THE COMMON FCB
;
CONOUT	EQU	2
OPEN	EQU	15
FCLOSE	EQU	16
ERAFIL	EQU	19
RDSEQ	EQU	20
WRSEQ	EQU	21
MAKFIL	EQU	22
SETDMA	EQU	26
;
FCBSIZ	EQU	36
NAMSIZ	EQU	11
FTY	EQU	11		;FCB: FILE TYPE
FLA	EQU	16		;FCB: LOAD ADDRESS
CFLD	EQU	18		;FCB: FOLDER - BLANK = THE ACTIVE ONE
CRN	EQU	26		;FCB: CURRENT RECORD
;
;	HEADER SECTOR OFFSETS
;
H_NAME	EQU	4
H_TYPE	EQU	15
H_LOAD	EQU	16
H_NSEC	EQU	18
;
;=================================================================
;
UNPACK:	B	@START		;THE SHELL ENTERS AT THE FIRST WORD
;
START:	LI	R0,BANNER
	CALL	@PUTS
;
;	THE ARCHIVE NAME: SKIP "UNPACK" AND THE SPACES AFTER IT
;
	MOV	@CMDLINE,R3
SKIP1:	CB	*R3+,@SPACE
	JHE	SKIP1A
	B	@USAGE		;END OF LINE: NO ARGUMENT
SKIP1A:	JNE	SKIP1
SKIP2:	CB	*R3+,@SPACE
	JEQ	SKIP2
	DEC	R3
	LI	R4,INFCB
	CALL	@MKFCB
	MOV	R1,R1
	JEQ	GOTNM
	B	@USAGE
GOTNM:
;
	LI	R2,SETDMA	;ALL DATA GOES THROUGH COMM_BUF
	MOV	@COMMBUF,R3
	CALL	@BDOS
;
	LI	R4,INFCB	;OPEN THE ARCHIVE
	LI	R2,OPEN
	CALL	@FCBCALL
	CI	R1,0FFH
	JEQ	NOARC1
	MOV	R1,R1
	JGT	OPENED
	JEQ	OPENED
NOARC1:	B	@NOARC
OPENED:
	CLR	@INFCB+CRN
	CLR	@NFILES
;
;	ONE FILE: ITS HEADER SECTOR, THEN ITS DATA
;
NEXTF:	LI	R4,INFCB
	LI	R2,RDSEQ
	CALL	@FCBCALL
	MOV	R1,R1
	JEQ	GOTHDR
	B	@NOEND		;THE ARCHIVE ENDED WITHOUT ITS END SECTOR
GOTHDR:
	MOV	@COMMBUF,R5
	C	*R5,@MAGIC
	JNE	BADARC
	C	@2(R5),@MAGIC+2
	JNE	BADARC
	MOVB	@H_NAME(R5),R0
	JEQ	ALLDONE		;THE END SECTOR
;
	LI	R4,OUTFCB	;A FRESH FCB FOR THE FILE
	LI	R0,FCBSIZ
CLRO:	CLR	*R4+		;(FCBSIZ IS EVEN)
	DECT	R0
	JNE	CLRO
	LI	R4,OUTFCB
	MOV	R5,R6
	AI	R6,H_NAME
	LI	R0,NAMSIZ
CPYN:	MOVB	*R6+,*R4+
	DEC	R0
	JNE	CPYN
	MOVB	@SPACE,@OUTFCB+CFLD
	MOVB	@H_TYPE(R5),@FTYV
	MOV	@H_LOAD(R5),@FLAV
	MOV	@H_NSEC(R5),@NSEC
;
	LI	R0,INDENT	;"  NAME.EXT"
	CALL	@PUTS
	LI	R5,OUTFCB
	CALL	@PUTFN
;
	LI	R4,OUTFCB	;REPLACE ANY FILE OF THAT NAME
	LI	R2,ERAFIL
	CALL	@FCBCALL
	LI	R4,OUTFCB
	LI	R2,MAKFIL
	CALL	@FCBCALL
	MOV	R1,R1
	JLT	MKERR
	CI	R1,0FFH
	JEQ	MKERR
	CLR	@OUTFCB+CRN
	CALL	@SETATT
;
;	COPY THE DATA, A SECTOR AT A TIME
;
COPY:	MOV	@NSEC,R0
	JEQ	CLOSEF
	LI	R4,INFCB
	LI	R2,RDSEQ
	CALL	@FCBCALL
	MOV	R1,R1
	JNE	SHORT
	LI	R4,OUTFCB
	LI	R2,WRSEQ
	CALL	@FCBCALL
	MOV	R1,R1
	JNE	WRERR
	DEC	@NSEC
	JMP	COPY
;
;	TYPE AND LOAD ADDRESS AGAIN - MAKE DOES NOT KEEP THEM, CLOSE
;	RECORDS THEM (AS XMODEM AND LINK99 DO)
;
CLOSEF:	CALL	@SETATT
	LI	R4,OUTFCB
	LI	R2,FCLOSE
	CALL	@FCBCALL
	MOV	R1,R1
	JLT	CLERR
	CI	R1,0FFH
	JEQ	CLERR
	INC	@NFILES
	LI	R0,CRLF
	CALL	@PUTS
	B	@NEXTF
;
ALLDONE:
	MOV	@NFILES,R1
	CALL	@PUTDEC
	LI	R0,DONEMSG
	CALL	@PUTS
EXIT:	CLR	R1
	B	@SHELL
;
;	ERRORS
;
USAGE:	LI	R0,USEMSG
	JMP	FAIL
NOARC:	LI	R0,NOAMSG
	JMP	FAIL
BADARC:	LI	R0,BADMSG
	JMP	FAIL
NOEND:	LI	R0,ENDMSG
	JMP	FAIL
SHORT:	LI	R0,SHTMSG
	JMP	FAIL
MKERR:	LI	R0,MKMSG
	JMP	FAIL
WRERR:	LI	R0,WRMSG
	JMP	FAIL
CLERR:	LI	R0,CLMSG
FAIL:	CALL	@PUTS
	B	@EXIT
;
;=================================================================
;	FCBCALL - BDOS FUNCTION R2 ON THE FCB AT R4, STAGED THROUGH
;	THE COMMON FCB.  RETURNS THE BDOS RESULT IN R1.
;=================================================================
FCBCALL:
	MOV	R4,@CURFCB
	MOV	R2,@CURFN
	MOV	@COMMFCB,R1
	LI	R0,FCBSIZ/2
STG:	MOV	*R4+,*R1+
	DEC	R0
	JNE	STG
	MOV	@CURFN,R2
	MOV	@COMMFCB,R3
	CALL	@BDOS
	MOV	R1,@RESULT
	MOV	@CURFCB,R4
	MOV	@COMMFCB,R1
	LI	R0,FCBSIZ/2
UNSTG:	MOV	*R1+,*R4+
	DEC	R0
	JNE	UNSTG
	MOV	@RESULT,R1
	RET
;
;	SETATT - THE TYPE AND LOAD ADDRESS FROM THE HEADER INTO OUTFCB
;
SETATT:	MOVB	@FTYV,@OUTFCB+FTY
	MOV	@FLAV,@OUTFCB+FLA
	RET
;
;=================================================================
;	MKFCB - THE FILE NAME AT R3 INTO A FRESH FCB AT R4.
;	NAME: UP TO 8 OF A-Z 0-9 _ (MORE ARE SKIPPED); ".EXT" OPTIONAL,
;	DEFAULT PAK.  R1 = 0 IF A NAME WAS FOUND.
;=================================================================
MKFCB:	MOV	R4,R5
	LI	R0,FCBSIZ
MK0:	CLR	*R5+
	DECT	R0
	JNE	MK0
	MOV	R4,R5
	LI	R0,NAMSIZ
MK1:	MOVB	@SPACE,*R5+
	DEC	R0
	JNE	MK1
	MOVB	@SPACE,@CFLD(R4)
	MOV	R4,R5		;R5: WHERE THE NEXT NAME CHARACTER GOES
	LI	R6,8		;ROOM LEFT IN THE NAME
	CLR	R7		;CHARACTERS FOUND
MK2:	CALL	@CHKCHAR
	JNE	MK4
	MOV	R6,R6
	JEQ	MK3		;PAST 8: SKIP IT
	CALL	@UPCHAR
	MOVB	R1,*R5+
	DEC	R6
	INC	R7
MK3:	INC	R3
	JMP	MK2
MK4:	MOV	R7,R7
	JEQ	MKNO
	CB	*R3,@DOT
	JNE	MKDEF
	INC	R3
	MOV	R4,R5
	AI	R5,8
	LI	R6,3
MK5:	CALL	@CHKCHAR
	JNE	MKYES
	CALL	@UPCHAR
	MOVB	R1,*R5+
	INC	R3
	DEC	R6
	JNE	MK5
	JMP	MKYES
MKDEF:	MOVB	@DEFEXT,@8(R4)	;NO EXTENSION: .PAK
	MOVB	@DEFEXT+1,@9(R4)
	MOVB	@DEFEXT+2,@10(R4)
MKYES:	CLR	R1
	RET
MKNO:	LI	R1,1
	RET
;
;	CHKCHAR - EQ IF *R3 IS A NAME CHARACTER: A-Z a-z 0-9 _
;	(XMODEM 1.9Q'S TEST)
;
CHKCHAR:
	MOVB	*R3,R1
	SRL	R1,8
	CI	R1,'_'
	JEQ	CHKY
	CI	R1,'0'
	JL	CHKN
	CI	R1,'9'
	JLE	CHKY
	ANDI	R1,00DFH
	AI	R1,-'A'
	CI	R1,0019H
	JH	CHKN
CHKY:	CLR	R1
	MOV	R1,R1		;CLR SETS NO STATUS: MAKE EQ HERE
	RET
CHKN:	LI	R1,1
	MOV	R1,R1
	RET
;
;	UPCHAR - *R3, A-Z FOR a-z, IN THE HIGH BYTE OF R1
;
UPCHAR:	MOVB	*R3,R1
	SRL	R1,8
	CI	R1,'a'
	JL	UP1
	CI	R1,'z'
	JH	UP1
	ANDI	R1,00DFH
UP1:	SWPB	R1
	RET
;
;=================================================================
;	CONSOLE OUTPUT
;=================================================================
;
;	PUTS - THE ZERO-ENDED STRING AT R0
;
PUTS:	MOVB	*R0+,R3
	JEQ	PUTS9
	MOV	R0,@SAVR0
	CALL	@PUTC
	MOV	@SAVR0,R0
	JMP	PUTS
PUTS9:	RET
;
;	PUTC - THE CHARACTER IN THE HIGH BYTE OF R3
;
PUTC:	SRL	R3,8
	LI	R2,CONOUT
	CALL	@BDOS
	RET
;
;	PUTFN - THE 8 + 3 NAME AT R5 AS NAME.EXT
;
PUTFN:	MOV	R5,@SAVR5
	LI	R6,8
PF1:	MOV	@SAVR5,R5
	MOVB	*R5+,R3
	MOV	R5,@SAVR5
	CB	R3,@SPACE
	JEQ	PF2
	MOV	R6,@SAVR6
	CALL	@PUTC
	MOV	@SAVR6,R6
PF2:	DEC	R6
	JNE	PF1
	MOV	@SAVR5,R5
	CB	*R5,@SPACE
	JEQ	PF9
	MOVB	@DOT,R3
	CALL	@PUTC
	LI	R6,3
PF3:	MOV	@SAVR5,R5
	MOVB	*R5+,R3
	MOV	R5,@SAVR5
	CB	R3,@SPACE
	JEQ	PF4
	MOV	R6,@SAVR6
	CALL	@PUTC
	MOV	@SAVR6,R6
PF4:	DEC	R6
	JNE	PF3
PF9:	RET
;
;	PUTDEC - R1 IN DECIMAL (0 TO 999)
;
PUTDEC:	CLR	R0		;R0:R1 / 100
	LI	R2,100
	DIV	R2,R0		;R0 = HUNDREDS, R1 = REST
	MOV	R1,@SAVR1
	MOV	R0,R3
	JEQ	PD1
	MOV	R3,@HUND
	AI	R3,'0'
	SWPB	R3
	CALL	@PUTC
PD1:	MOV	@SAVR1,R1
	CLR	R0
	LI	R2,10
	DIV	R2,R0		;R0 = TENS, R1 = UNITS
	MOV	R1,@SAVR1
	MOV	R0,R3
	JNE	PD2
	MOV	@HUND,R0	;A ZERO TEN IS PRINTED AFTER HUNDREDS
	JEQ	PD3
PD2:	AI	R3,'0'
	SWPB	R3
	CALL	@PUTC
PD3:	MOV	@SAVR1,R3
	AI	R3,'0'
	SWPB	R3
	CALL	@PUTC
	RET
;
;=================================================================
;	DATA
;=================================================================
SPACE	BYTE	20H
DOT	BYTE	'.'
DEFEXT	TEXT	'PAK'
	EVEN
MAGIC	TEXT	'PK99'
BANNER	TEXT	'UNPACK 1.0'
	BYTE	0DH,0AH,0
INDENT	TEXT	'  '
	BYTE	0
CRLF	BYTE	0DH,0AH,0
DONEMSG	TEXT	' FILE(S) UNPACKED.'
	BYTE	0DH,0AH,0
USEMSG	TEXT	'** USAGE: UNPACK <ARCHIVE>   (NO EXTENSION: .PAK) **'
	BYTE	0DH,0AH,0
NOAMSG	TEXT	'** ARCHIVE NOT FOUND **'
	BYTE	0DH,0AH,0
BADMSG	TEXT	'** NOT A PACK99 ARCHIVE **'
	BYTE	0DH,0AH,0
ENDMSG	TEXT	'** ARCHIVE ENDS EARLY - NO END SECTOR **'
	BYTE	0DH,0AH,0
SHTMSG	BYTE	0DH,0AH
	TEXT	'** ARCHIVE ENDS INSIDE A FILE **'
	BYTE	0DH,0AH,0
MKMSG	BYTE	0DH,0AH
	TEXT	'** FILE CREATE ERROR **'
	BYTE	0DH,0AH,0
WRMSG	BYTE	0DH,0AH
	TEXT	'** FILE WRITE ERROR **'
	BYTE	0DH,0AH,0
CLMSG	BYTE	0DH,0AH
	TEXT	'** FILE CLOSE ERROR **'
	BYTE	0DH,0AH,0
	EVEN
;
NFILES	WORD	0		;FILES WRITTEN
NSEC	WORD	0		;DATA SECTORS LEFT IN THIS FILE
FLAV	WORD	0		;ITS LOAD ADDRESS
CURFCB	WORD	0
CURFN	WORD	0
RESULT	WORD	0
SAVR0	WORD	0
SAVR1	WORD	0
SAVR5	WORD	0
SAVR6	WORD	0
HUND	WORD	0
FTYV	BYTE	0		;ITS TYPE
	EVEN
INFCB	BSS	FCBSIZ		;THE ARCHIVE
OUTFCB	BSS	FCBSIZ		;THE FILE BEING WRITTEN
;
	END

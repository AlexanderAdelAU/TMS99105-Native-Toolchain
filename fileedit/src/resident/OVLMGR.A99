;*******************************************************************
;  OVLMGR.A99 - Overlay Manager (consolidated, single manager)
;  TMS99105 SBC
;
;  Maps one overlay: every (segment, page) pair in its row of
;  OVL_TABLE.  The thunks LINK99 -Y writes reach it through OVCALL.
;
;    LI   R1,id          ; overlay ID
;    CALL @OVLMGR        ; map it (uses R0, R2, R3, R5, R12)
;*******************************************************************

;*******************************************************************
;  FILEEDIT MEMORY GEOMETRY
;
;    >1000-7FFF  resident code / data (including OVLMGR and OVCALL)
;    >8000-8FFF  code overlay window, segment 8 ONLY
;    >9000-BFFF  editor data banking (EBMAP.A99, segments 9-B)
;    >C000-DFFF  shell / optional editor data bank (EBMAP.A99)
;    >E000-FFFF  BDOS / ROM - never remapped by FileEdit
;
;  The generic OVL_TABLE supports up to five (segment,page) pairs per
;  overlay and its row stride is 20 bytes. In THIS application, however,
;  the OVL99 generator rejects all code overlays except segment 8 to
;  prevent accidental overwrites of the document banks.
;
;  CUR_WINA_ID tracks the logical overlay mapped in segment 8. OVCALL
;  saves/restores this owner for nested cross-overlay calls; EBMAP manages
;  its other independent segments without involving OVLMGR.
;*******************************************************************

;--- CONSTANTS ---
	DXOP	PSEL_DIS,0
	DXOP	PSEL_EN,1
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	WHEX,10
	DXOP	MESG,14

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
R10	EQU	10
R11	EQU	11
R12	EQU	12
WP	EQU	13
R13	EQU	13
R14	EQU	14
R15	EQU	15
SP	EQU	10

MAP_WIN_BASE:	EQU	080C0H
BYTEWIDE:	EQU	2		;LDCR count 2 = parallel byte transfer

WINA_SEG2:	EQU	16		;window A's FIRST segment * 2
					;(segment 8 -> >8000). Only used to
					;decide when CUR_WINA_ID is updated.
OVLROW:		EQU	20		;bytes per OVL_TABLE row (5 pairs)

;--- the table: built by LINK99 -Y from OVLMAP.TXT, in OVLGLUE ---
	EXT	OVL_TABLE

;--- PER-SEGMENT "currently loaded page" tracker, indexed segment*2 ---
CURRENT_PAGE:
	WORD	0,0,0,0,0,0,0,0
	WORD	0,0,0,0,0,0,0,0

;--- PER-SEGMENT "currently active overlay ID" tracker ---
CURRENT_ID:
	WORD	0,0,0,0,0,0,0,0
	WORD	0,0,0,0,0,0,0,0

;--- the window-A overlay ID (EXT CUR_WINA_ID in OVCALL).
;    For a multi-page overlay this is the ID of the whole set: one ID
;    identifies every page of it. ---
CUR_WINA_ID:
	WORD	0

;*******************************************************************
;  OVLMGR - Overlay Manager
;
;  Entry: R1 = overlay ID
;  Modifies: R0, R2, R3, R5, R12
;  Preserves: R1, R4, R6-R11, R13-R15  (R1 unchanged on return)
;
;  Walks the row's (segment,page) pairs until a zero segment ends the
;  list, mapping each.
;*******************************************************************
OVLMGR:
	MOV	R1,R3
	SLA	R3,4			;ID*16
	MOV	R1,R5
	SLA	R5,2			;ID*4
	A	R5,R3			;R3 = ID*20, the row's byte offset
	CLR	R5			;R5 = byte offset of the pair

;--- one (segment,page) pair per iteration; segment 0 ends the row ---
OVLM_PAIR:
	MOV	R3,R2
	A	R5,R2			;R2 -> this pair
	MOV	@OVL_TABLE+2(R2),R0	;R0 = physical page. Read the page
					;BEFORE overwriting R2 with the
					;segment, so only one index is live.
	MOV	@OVL_TABLE(R2),R2	;R2 = segment (source is fetched
					;before the destination is written,
					;so reusing R2 is safe here)
	JEQ	OVLMGR_RET		;segment 0 -> no more pages
	SLA	R2,1			;R2 = segment*2, which is both the
					;table word-offset and the CRU scale

	MOV	R1,@CURRENT_ID(R2)	;record the ID for this segment
	CI	R2,WINA_SEG2		;window A's FIRST segment?
	JNE	OVLM_P1
	MOV	R1,@CUR_WINA_ID		;new window owner
OVLM_P1:
	C	R0,@CURRENT_PAGE(R2)
	JEQ	OVLM_NEXT		;this page is already here

	MOV	R0,@CURRENT_PAGE(R2)

	;--- program the map register: PSEL off, LDCR, PSEL on ---
	SLA	R0,8			;page into high byte for LDCR
	PSEL_DIS
	LI	R12,MAP_WIN_BASE
	A	R2,R12			;R12 = MAP_WIN_BASE + segment*2
	LDCR	R0,BYTEWIDE
	PSEL_EN

OVLM_NEXT:
	AI	R5,4			;next pair
	CI	R5,OVLROW
	JNE	OVLM_PAIR

OVLMGR_RET:
	RET


;*******************************************************************
;  OVLMGR_INIT - Initialise overlay manager. Call once at startup.
;*******************************************************************
OVLMGR_INIT:
	LI	R0,CURRENT_PAGE
	LI	R1,32			;16 words CURRENT_PAGE + 16 words
					;CURRENT_ID, contiguous
OVLMGR_INITL:
	CLR	*R0+
	DEC	R1
	JNE	OVLMGR_INITL
	CLR	@CUR_WINA_ID		; OVL99 requires a known initial window owner
	PSEL_EN
	RET

	ENT	OVLMGR
	ENT	OVLMGR_INIT
	ENT	CUR_WINA_ID

	END

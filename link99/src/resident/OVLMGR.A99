;*******************************************************************
;  OVLMGR.A99 - Overlay Manager (consolidated, single manager)
;  TMS99105 SBC
;
;  USAGE:
;    LI   R1,overlay_id
;    CALL @OVLMGR       ; map requested code/data bank if needed
;
;  For executable overlays, the resident adapter may then CALL the generated
;  entry anchor. Data-only banks are mapped for storage access and are never
;  executable targets.
;*******************************************************************

;*******************************************************************
;  MEMORY GEOMETRY
;
;    >1000-7FFF   resident / common (page 0)          28K
;    >8000-BFFF   window A -- FOUR pages, segments 8..11
;    >C000        shell / monitor
;
;  LINK99 uses this window for two distinct purposes:
;    * callable executable overlays (currently OVL_USAGE), and
;    * mapped data banks/workspaces (target code and symbol/XREF storage).
;
;  The distinction is explicit. A callable overlay must own segment 8; a
;  data-only mapping may use other segments but must never be entered as code.
;
;  MAP_WIN_BASE (>80C0) is a CRU address and is unrelated to memory
;  segment 8. It does not move.
;*******************************************************************

;*******************************************************************
;  OVERLAY TABLE / OWNERSHIP MODEL
;
;  OVL_TABLE rows are ten words -- up to five explicit (segment,page)
;  pairs -- so index = ID*20. A zero segment terminates the row. Physical
;  pages are explicit; no consecutive-page assumption is made here.
;
;  CUR_WINA_ID is established only when the row maps virtual segment 8.
;  Therefore every callable/executable overlay MUST include segment 8 and
;  should list it as the first pair. Data-only banks may be explicit
;  exceptions (for example the SYMBOLS workspace at segments 9..11), but
;  such a mapping must never become an executable transfer target.
;
;  make_SBC_link99.ps1 classifies each generated row as Executable or Data
;  and fails the build if an executable mapping violates this invariant.
;*******************************************************************

;--- CONSTANTS ---
	DXOP	PSEL,2
	DXOP	PSEL_DIS,0
	DXOP	PSEL_EN,1
	DXOP	CALL,6
	DXOP	RET,7
	DXOP	WHEX,10
	DXOP	MESG,14

R0	EQU	0
R1	EQU	1
R2	EQU	2
R3	EQU	3
R4	EQU	4
R5	EQU	5
R6	EQU	6
R7	EQU	7
R8	EQU	8
R9	EQU	9
R10	EQU	10
R11	EQU	11
R12	EQU	12
WP	EQU	13
R13	EQU	13
R14	EQU	14
R15	EQU	15
SP	EQU	10

MAP_WIN_BASE:	EQU	080C0H
BYTEWIDE:	EQU	2		;CRU BITS PER MAP REGISTER (unchanged)

WINA_SEG2:	EQU	16		;window A's FIRST segment * 2
					;(segment 8 -> >8000). Only used to
					;decide when CUR_WINA_ID is updated.
OVLROW:		EQU	20		;bytes per OVL_TABLE row (5 pairs)

;--- the table: built by link99 -Y from OVLMAP.TXT, in OVLGLUE ---
	EXT	OVL_TABLE		;built by link99 -Y from OVLMAP.TXT

;--- PER-SEGMENT "currently loaded page" tracker, indexed segment*2 ---
CURRENT_PAGE:
	WORD	0,0,0,0,0,0,0,0
	WORD	0,0,0,0,0,0,0,0

;--- PER-SEGMENT "currently active overlay ID" tracker ---
CURRENT_ID:
	WORD	0,0,0,0,0,0,0,0
	WORD	0,0,0,0,0,0,0,0

;--- logical owner of the segment-8 overlay window.
;    Mapping an executable overlay must set this by owning segment 8.
;    OVLMGR_INIT explicitly resets it to zero before first use. ---
CUR_WINA_ID:
	WORD	0

;*******************************************************************
;  OVLMGR - Overlay Manager
;
;  Entry: R1 = overlay ID
;  Modifies: R0, R2, R3, R5, R12
;  Preserves: R1, R4, R6-R11, R13-R15  (R1 unchanged on return)
;
;  Walks the row's (segment,page) pairs until a zero segment ends the
;  list, mapping each. The CRU-write sequence inside the loop is the
;  proven one, unchanged; only the surrounding iteration is new.
;*******************************************************************
OVLMGR:
	MOV	R1,R3
	SLA	R3,4			;ID*16
	MOV	R1,R5
	SLA	R5,2			;ID*4
	A	R5,R3			;R3 = ID*20, the row's byte offset
	CLR	R5			;R5 = byte offset of the pair

;--- one (segment,page) pair per iteration; segment 0 ends the row ---
OVLM_PAIR:
	MOV	R3,R2
	A	R5,R2			;R2 -> this pair
	MOV	@OVL_TABLE+2(R2),R0	;R0 = physical page. Read the page
					;BEFORE overwriting R2 with the
					;segment, so only one index is live.
	MOV	@OVL_TABLE(R2),R2	;R2 = segment (source is fetched
					;before the destination is written,
					;so reusing R2 is safe here)
	JEQ	OVLMGR_RET		;segment 0 -> no more pages
	SLA	R2,1			;R2 = segment*2, which is both the
					;table word-offset and the CRU scale

	MOV	R1,@CURRENT_ID(R2)	;record the ID for this segment
	CI	R2,WINA_SEG2		;window A's FIRST segment?
	JNE	OVLM_P1
	MOV	R1,@CUR_WINA_ID		;logical owner of the mapped window
OVLM_P1:
	C	R0,@CURRENT_PAGE(R2)
	JEQ	OVLM_NEXT		;this page is already here

	MOV	R0,@CURRENT_PAGE(R2)

	;--- PROVEN CRU-WRITE SEQUENCE, UNCHANGED ---
	SLA	R0,8			;page into high byte for LDCR
	PSEL_DIS
	LI	R12,MAP_WIN_BASE
	A	R2,R12			;R12 = MAP_WIN_BASE + segment*2
	LDCR	R0,BYTEWIDE
	PSEL_EN

OVLM_NEXT:
	AI	R5,4			;next pair
	CI	R5,OVLROW
	JNE	OVLM_PAIR

OVLMGR_RET:
	RET


;*******************************************************************
;  OVLMGR_INIT - Initialise overlay manager. Call once at startup.
;
;  Ownership invariant:
;    CUR_WINA_ID is the logical owner of the mapped overlay window and is
;    updated when an overlay maps virtual segment 8.  It must never inherit
;    a value from a previous program invocation, so startup explicitly clears
;    it as part of the manager state.
;
;  Executable/callable overlays must include segment 8 in their mapping.
;  Data-only banks may map other segments, but must never be entered as code.
;*******************************************************************
OVLMGR_INIT:
	LI	R0,CURRENT_PAGE
	LI	R1,32			;16 words CURRENT_PAGE + 16 words
					;CURRENT_ID, contiguous
OVLMGR_INITL:
	CLR	*R0+
	DEC	R1
	JNE	OVLMGR_INITL
	CLR	@CUR_WINA_ID		;explicitly establish: no window owner
	PSEL_EN
	RET

	ENT	OVLMGR
	ENT	OVLMGR_INIT
	ENT	CUR_WINA_ID

	END

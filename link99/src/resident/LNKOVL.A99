;*******************************************************************
; LNKOVL.A99 -- LINK99 resident overlay entry adapters.
;
; LINK99-specific glue only.  The shared OVLMGR.A99 is not modified.
;
; Small-C/Plus and the shared overlay framework use XOP6 CALL / XOP7 RET.
; Each wrapper follows the proven sequence:
;
;       LI   R1,overlay_id
;       CALL @OVLMGR
;       CALL @overlay_entry
;       RET
;
; lnkovlinit must be called once before LINK99 performs normal application
; work. OVLMGR_INIT explicitly resets CUR_WINA_ID as well as its per-segment
; caches. Any callable/executable overlay must include segment 8 so mapping it
; establishes the logical window owner. Data-only banks are the only exception.
;*******************************************************************

        DXOP    CALL,6
        DXOP    RET,7

R1      EQU     1

        INCL    "OVLADDR.INC"

        EXT     OVLMGR
        EXT     OVLMGR_INIT

lnkovlinit:
        CALL    @OVLMGR_INIT
        RET

runbase:
        LI      R1,1
        CALL    @OVLMGR
        CALL    @O_BASE
        RET

        ENT     lnkovlinit
        ENT     runbase
        END
